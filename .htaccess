# SHARED-AUTH (authV2): nạp autoload + cấu hình phiên dùng chung TRƯỚC mọi request PHP, để ~25
# session_start() rải rác cùng tham gia phiên SSO mà không phải sửa từng file.
# mod_php (apache2handler) → php_value. PHP-FPM/CGI thì thay bằng .user.ini.
# ⚠️ PRODUCTION (XAMPP): đổi path cho khớp, vd "C:/xampp/htdocs/authV2/prepend.php".
php_value auto_prepend_file "C:/laragon/www/authV2/prepend.php"

# Block development-only artifacts from direct web access.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^dev-tools(/|$) - [F,L]
    RewriteRule ^(test_.*|debug.*|check_.*|alter_table|migrate_settings|update_column_name|db_update_.*|fix.*)\.php$ - [F,L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)^(\.gitignore|composer\.(json|lock)|package\.json|phpcs\.xml)$|\.(log|bak|backup|sql|phar|ps1|bat)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)^(\.gitignore|composer\.(json|lock)|package\.json|phpcs\.xml)$|\.(log|bak|backup|sql|phar|ps1|bat)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
